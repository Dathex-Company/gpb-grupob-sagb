{
  "info": {
    "name": "API SagB v1.0.0",
    "description": "Coleção oficial da API SagB — gateway unificado para os serviços do ecossistema SagB.\n\n## Autenticação\nTodas as requisições exigem o header `X-API-Key` com uma chave válida.\n\n## Versionamento\nVersão padrão: `v1`. Use o header `Accept-Version` para especificar uma versão.\n\n## Documentação\n- OpenAPI: https://api.sagb.com.br/docs\n- Changelog: https://github.com/sagb/api-sagb/blob/main/CHANGELOG_API.md\n- Política de Depreciação: vide docs internos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "sagb-dande-conec"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "in",
        "value": "header",
        "type": "string"
      },
      {
        "key": "value",
        "value": "sgb_sandbox_admin",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "System",
      "description": "Endpoints de sistema e healthcheck",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Verifica o status da API SagB. Não requer autenticação para leitura básica."
          },
          "response": [
            {
              "name": "Sucesso",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "X-Request-Id", "value": "uuid-v4" },
                { "key": "X-API-Version", "value": "1.0.0" },
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"version\": \"1.0.0\",\n  \"timestamp\": \"2026-05-05T00:00:00.000Z\",\n  \"module\": \"api-sagb\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "TaskZei",
      "description": "Integração com o sistema de notificações TaskZei",
      "item": [
        {
          "name": "Listar Notificações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/taskzei/notifications?recipient_id={{recipientId}}&status=pending&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "taskzei", "notifications"],
              "query": [
                { "key": "recipient_id", "value": "{{recipientId}}" },
                { "key": "status", "value": "pending" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Lista notificações do TaskZei com filtros opcionais."
          },
          "response": [
            {
              "name": "Sucesso",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": \"notif-001\",\n      \"title\": \"Nova mensagem\",\n      \"message\": \"Você recebeu uma nova mensagem de Sandri\",\n      \"type\": \"info\",\n      \"status\": \"pending\",\n      \"created_at\": \"2026-05-05T00:00:00.000Z\"\n    }\n  ],\n  \"meta\": {\n    \"total\": 1,\n    \"limit\": 20,\n    \"offset\": 0\n  }\n}"
            }
          ]
        },
        {
          "name": "Enviar Notificação",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/taskzei/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "taskzei", "notifications"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bem-vindo à API SagB\",\n  \"message\": \"Sua integração foi configurada com sucesso!\",\n  \"type\": \"success\",\n  \"recipient_ids\": [\"user-123\", \"user-456\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Envia uma nova notificação através do TaskZei."
          },
          "response": [
            {
              "name": "Criado",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"notif-002\",\n    \"title\": \"Bem-vindo à API SagB\",\n    \"status\": \"sent\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "CRM",
      "description": "Gestão de leads via CRM Ziplia",
