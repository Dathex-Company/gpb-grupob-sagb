              "name": "Sucesso",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": \"lead-001\",\n      \"name\": \"Empresa Exemplo Ltda\",\n      \"email\": \"contato@exemplo.com\",\n      \"phone\": \"(11) 99999-8888\",\n      \"status\": \"active\",\n      \"created_at\": \"2026-01-15T00:00:00.000Z\"\n    }\n  ],\n  \"meta\": {\n    \"total\": 1,\n    \"limit\": 10,\n    \"offset\": 0\n  }\n}"
