    {
      "name": "Auth (Erros)",
      "description": "Cenários de erro de autenticação para validação",
      "item": [
        {
          "name": "401 - Sem API Key",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Requisição sem header X-API-Key. Deve retornar 401."
          },
          "response": [
            {
              "name": "Não Autorizado",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"UNAUTHORIZED\",\n    \"message\": \"API Key is required\"\n  }\n}"
            }
          ]
        },
        {
          "name": "401 - API Key Inválida",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "in", "value": "header", "type": "string" },
                { "key": "value", "value": "invalid_key_123", "type": "string" },
                { "key": "key", "value": "X-API-Key", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Requisição com API Key inválida. Deve retornar 401."
          },
          "response": [
            {
              "name": "Não Autorizado",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"UNAUTHORIZED\",\n    \"message\": \"Invalid API Key\"\n  }\n}"
            }
          ]
        },
        {
          "name": "403 - Scope Insuficiente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/crm/leads",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "crm", "leads"]
            },
            "description": "Requisição com API Key que não possui o scope `agents:read`. Deve retornar 403."
          },
          "response": [
            {
              "name": "Proibido",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"FORBIDDEN\",\n    \"message\": \"Missing one or more required scopes: agents:read\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Rate Limiting",
      "description": "Testes de rate limiting (429 Too Many Requests)",
      "item": [
        {
          "name": "429 - Excedeu Limite",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Após exceder o limite de requisições por minuto. Deve retornar 429 com header Retry-After."
          },
          "response": [
            {
              "name": "Muitas Requisições",
              "status": "Too Many Requests",
              "code": 429,
              "header": [
                { "key": "Retry-After", "value": "6" },
                { "key": "X-RateLimit-Limit", "value": "100" },
                { "key": "X-RateLimit-Remaining", "value": "0" }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"RATE_LIMIT_EXCEEDED\",\n    \"message\": \"Too many requests. Please retry after the specified time.\"\n  }\n}"
            }
          ]
        }
      ]
    }
  ],
