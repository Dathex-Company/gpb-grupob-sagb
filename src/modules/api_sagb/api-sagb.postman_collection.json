              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"lead-001\",\n    \"name\": \"Empresa Exemplo Ltda\",\n    \"email\": \"contato@exemplo.com\",\n    \"phone\": \"(11) 99999-8888\",\n    \"status\": \"active\",\n    \"created_at\": \"2026-01-15T00:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Atualizar Lead",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/crm/leads/{{leadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "crm", "leads", "{{leadId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa Exemplo Atualizada\",\n  \"status\": \"qualified\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Atualiza os dados de um lead existente."
          },
          "response": [
            {
              "name": "Sucesso",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"lead-001\",\n    \"name\": \"Empresa Exemplo Atualizada\",\n    \"status\": \"qualified\"\n  }\n}"
