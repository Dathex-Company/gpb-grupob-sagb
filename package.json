{
  "name": "sagb",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tunnel": "lt --port 8000 --subdomain sagb-exec",
    "start": "concurrently \"npm run dev\" \"npm run tunnel\"",
    "whisper:local": "python tools/local_whisper_server.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "history:check": "node tools/check-history.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.102.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@whiskeysockets/baileys": "^6.7.9",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "vite": "^7.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "localtunnel": "^2.0.2",
    "supabase": "^2.84.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
